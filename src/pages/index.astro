<main>
  <section class="pc-wrap" aria-label="Pest Control Instant Quote">
    <header class="pc-head">
      <h1 class="pc-title">Pest Control Instant Quote</h1>
      <p class="pc-sub">
        Select your service options and add-ons. Your estimate updates instantly and you can send the details on WhatsApp.
      </p>
    </header>

    <div class="pc-grid">
      <!-- LEFT: Form -->
      <div class="pc-panel" aria-label="Quote options">
        <div class="pc-block">
          <div class="pc-label">Service details</div>

          <div class="pc-form">
            <label class="pc-field">
              <span class="pc-field-label">Property type</span>
              <select id="pcProperty" class="pc-select">
                <option value="hdb">HDB</option>
                <option value="condo">Condo</option>
                <option value="landed">Landed</option>
                <option value="commercial">Commercial</option>
              </select>
            </label>

            <label class="pc-field">
              <span class="pc-field-label">Pest type</span>
              <select id="pcPest" class="pc-select">
                <option value="cockroaches">Cockroaches</option>
                <option value="ants">Ants</option>
                <option value="termites">Termites</option>
                <option value="bed_bugs">Bed bugs</option>
                <option value="mosquitoes">Mosquitoes</option>
                <option value="rodents">Rodents</option>
                <option value="general">General pest</option>
              </select>
            </label>

            <label class="pc-field">
              <span class="pc-field-label">Plan</span>
              <select id="pcPlan" class="pc-select">
                <option value="one_time">One-time</option>
                <option value="quarterly">Quarterly</option>
                <option value="monthly">Monthly</option>
              </select>
            </label>

            <label class="pc-field">
              <span class="pc-field-label">Urgency</span>
              <select id="pcUrgency" class="pc-select">
                <option value="standard">Standard</option>
                <option value="urgent">Urgent (same/next day)</option>
              </select>
            </label>

            <label class="pc-field">
              <span class="pc-field-label">Access complexity</span>
              <select id="pcAccess" class="pc-select">
                <option value="normal">Normal</option>
                <option value="hard">Hard (tight spaces / high clutter)</option>
              </select>
            </label>
          </div>
        </div>

        <div class="pc-block">
          <div class="pc-label">Add-ons</div>

          <div class="pc-addons" role="group" aria-label="Add-ons">
            <label class="pc-addon">
              <input type="checkbox" data-addon="inspection_report" />
              <span class="pc-addon-text">
                <span class="pc-addon-title">Inspection report</span>
                <span class="pc-addon-meta">+ SGD 40</span>
              </span>
            </label>

            <label class="pc-addon">
              <input type="checkbox" data-addon="aftercare" />
              <span class="pc-addon-text">
                <span class="pc-addon-title">30-day aftercare support</span>
                <span class="pc-addon-meta">+ SGD 30</span>
              </span>
            </label>

            <label class="pc-addon">
              <input type="checkbox" data-addon="gel_bait_upgrade" />
              <span class="pc-addon-text">
                <span class="pc-addon-title">Gel bait upgrade</span>
                <span class="pc-addon-meta">+ SGD 35</span>
              </span>
            </label>

            <label class="pc-addon">
              <input type="checkbox" data-addon="rodent_traps" />
              <span class="pc-addon-text">
                <span class="pc-addon-title">Extra traps (rodents)</span>
                <span class="pc-addon-meta">+ SGD 45</span>
              </span>
            </label>

            <label class="pc-addon">
              <input type="checkbox" data-addon="follow_up_visit" />
              <span class="pc-addon-text">
                <span class="pc-addon-title">Follow-up visit</span>
                <span class="pc-addon-meta">+ SGD 90</span>
              </span>
            </label>
          </div>

          <div class="pc-hint">
            Tip: For termites/bed bugs, the final quote often depends on infestation level — keep this as an estimate for demo.
          </div>
        </div>
      </div>

      <!-- RIGHT: Summary -->
      <aside class="pc-panel pc-summary" aria-label="Quote summary">
        <div class="pc-sum-head">
          <div>
            <div class="pc-sum-title">Estimate</div>
            <div class="pc-sum-sub">Live preview of selections + message output.</div>
          </div>
          <div class="pc-badge" id="pcBadge">Ready</div>
        </div>

        <div class="pc-card">
          <div class="pc-row">
            <div class="pc-k">Property</div>
            <div class="pc-v" id="pcOutProperty">HDB</div>
          </div>
          <div class="pc-row">
            <div class="pc-k">Pest</div>
            <div class="pc-v" id="pcOutPest">Cockroaches</div>
          </div>
          <div class="pc-row">
            <div class="pc-k">Plan</div>
            <div class="pc-v" id="pcOutPlan">One-time</div>
          </div>
          <div class="pc-row">
            <div class="pc-k">Urgency</div>
            <div class="pc-v" id="pcOutUrgency">Standard</div>
          </div>
          <div class="pc-row">
            <div class="pc-k">Access</div>
            <div class="pc-v" id="pcOutAccess">Normal</div>
          </div>

          <div class="pc-divider"></div>

          <div class="pc-row pc-row-top">
            <div class="pc-k">Add-ons</div>
            <div class="pc-v pc-small" id="pcOutAddons">None</div>
          </div>

          <div class="pc-divider"></div>

          <div class="pc-total">
            <div class="pc-total-left">
              <div class="pc-total-label">Total estimate</div>
              <div class="pc-total-note">Includes plan + urgency + access + add-ons.</div>
            </div>
            <div class="pc-money" id="pcOutTotal">SGD 0</div>
          </div>
        </div>

        <div class="pc-actions">
          <button class="pc-btn pc-primary" type="button" id="pcWhatsAppBtn">
            Send on WhatsApp
          </button>
          <button class="pc-btn pc-ghost" type="button" id="pcCopyBtn">
            Copy message
          </button>
        </div>

        <div class="pc-toast" id="pcToast" aria-live="polite"></div>

        <details class="pc-details">
          <summary>Preview generated message</summary>
          <pre class="pc-pre" id="pcPreviewMsg"></pre>
        </details>
      </aside>
    </div>
  </section>

  <script is:inline>
    (function () {
      // ===== CONFIG =====
      const WHATSAPP_NUMBER = "6591837777"; // change if needed
      const CURRENCY = "SGD";

      // Pricing model (demo-friendly, editable)
      const BASE_BY_PEST = {
        ants: 120,
        cockroaches: 150,
        termites: 380,
        bed_bugs: 420,
        mosquitoes: 180,
        rodents: 220,
        general: 160,
      };

      const MULT_PROPERTY = {
        hdb: 1.0,
        condo: 1.1,
        landed: 1.35,
        commercial: 1.45,
      };

      const MULT_URGENCY = { standard: 1.0, urgent: 1.2 };
      const MULT_ACCESS = { normal: 1.0, hard: 1.15 };

      // Bundled plan multipliers
      const PLAN_MULT = {
        one_time: 1.0,
        quarterly: 2.6,
        monthly: 4.6,
      };

      const ADDONS = {
        inspection_report: { label: "Inspection report", price: 40 },
        aftercare: { label: "30-day aftercare support", price: 30 },
        gel_bait_upgrade: { label: "Gel bait upgrade", price: 35 },
        rodent_traps: { label: "Extra traps (rodents)", price: 45 },
        follow_up_visit: { label: "Follow-up visit", price: 90 },
      };

      // ===== DOM =====
      const elProperty = document.getElementById("pcProperty");
      const elPest = document.getElementById("pcPest");
      const elPlan = document.getElementById("pcPlan");
      const elUrgency = document.getElementById("pcUrgency");
      const elAccess = document.getElementById("pcAccess");
      const elAddonChecks = document.querySelectorAll('input[type="checkbox"][data-addon]');

      const outProperty = document.getElementById("pcOutProperty");
      const outPest = document.getElementById("pcOutPest");
      const outPlan = document.getElementById("pcOutPlan");
      const outUrgency = document.getElementById("pcOutUrgency");
      const outAccess = document.getElementById("pcOutAccess");
      const outAddons = document.getElementById("pcOutAddons");
      const outTotal = document.getElementById("pcOutTotal");

      const btnWA = document.getElementById("pcWhatsAppBtn");
      const btnCopy = document.getElementById("pcCopyBtn");
      const toast = document.getElementById("pcToast");
      const badge = document.getElementById("pcBadge");
      const preview = document.getElementById("pcPreviewMsg");

      // ===== STATE =====
      const state = {
        property: "hdb",
        pest: "cockroaches",
        plan: "one_time",
        urgency: "standard",
        access: "normal",
        addons: new Set(),
      };

      // ===== LABELS =====
      function labelProperty(v) {
        return v === "hdb" ? "HDB" :
               v === "condo" ? "Condo" :
               v === "landed" ? "Landed" : "Commercial";
      }
      function labelPlan(v) {
        return v === "one_time" ? "One-time" :
               v === "quarterly" ? "Quarterly" : "Monthly";
      }
      function labelUrgency(v) {
        return v === "standard" ? "Standard" : "Urgent (same/next day)";
      }
      function labelAccess(v) {
        return v === "normal" ? "Normal" : "Hard (tight spaces / high clutter)";
      }
      function labelPest(v) {
        const map = {
          ants: "Ants",
          cockroaches: "Cockroaches",
          termites: "Termites",
          bed_bugs: "Bed bugs",
          mosquitoes: "Mosquitoes",
          rodents: "Rodents",
          general: "General pest",
        };
        return map[v] || "Pest";
      }

      function money(n) {
        return `${CURRENCY} ${Math.round(n)}`;
      }

      function compute() {
        const base = BASE_BY_PEST[state.pest] || 0;
        const mult =
          (MULT_PROPERTY[state.property] || 1) *
          (PLAN_MULT[state.plan] || 1) *
          (MULT_URGENCY[state.urgency] || 1) *
          (MULT_ACCESS[state.access] || 1);

        const serviceSubtotal = base * mult;

        let addonsTotal = 0;
        state.addons.forEach((k) => {
          addonsTotal += (ADDONS[k]?.price || 0);
        });

        const total = serviceSubtotal + addonsTotal;
        return { base, serviceSubtotal, addonsTotal, total };
      }

      function buildMessage(total) {
        const addonLabels = Array.from(state.addons).map((k) => ADDONS[k].label);

        const lines = [
          "Hi! I'd like a pest control quote:",
          "",
          `• Property: ${labelProperty(state.property)}`,
          `• Pest: ${labelPest(state.pest)}`,
          `• Plan: ${labelPlan(state.plan)}`,
          `• Urgency: ${labelUrgency(state.urgency)}`,
          `• Access: ${labelAccess(state.access)}`,
          `• Add-ons: ${addonLabels.length ? addonLabels.join(", ") : "None"}`,
          "",
          `Estimated Total: ${money(total)}`,
          "",
          "Please advise earliest availability. Thank you!",
        ];
        return lines.join("\n");
      }

      function setToast(msg, kind) {
        toast.textContent = msg;
        toast.classList.remove("ok", "warn");
        toast.classList.add(kind || "ok");
        // stable height already reserved; this just fades in/out
        toast.style.opacity = "1";
        clearTimeout(setToast._t);
        setToast._t = setTimeout(() => {
          toast.style.opacity = "0";
        }, 1600);
      }

      function setBadge(text) {
        badge.textContent = text;
      }

      function render() {
        const { total } = compute();

        outProperty.textContent = labelProperty(state.property);
        outPest.textContent = labelPest(state.pest);
        outPlan.textContent = labelPlan(state.plan);
        outUrgency.textContent = labelUrgency(state.urgency);
        outAccess.textContent = labelAccess(state.access);

        const addonLabels = Array.from(state.addons).map((k) => ADDONS[k].label);
        outAddons.textContent = addonLabels.length ? addonLabels.join(", ") : "None";

        outTotal.textContent = money(total);

        const msg = buildMessage(total);
        preview.textContent = msg;

        btnWA.setAttribute("data-wa", `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(msg)}`);
        btnCopy.setAttribute("data-msg", msg);

        setBadge("Updated");
        clearTimeout(render._b);
        render._b = setTimeout(() => setBadge("Ready"), 600);
      }

      // ===== BINDINGS =====
      function bindSelect(el, key) {
        el.addEventListener("change", () => {
          state[key] = el.value;
          render();
        });
      }

      bindSelect(elProperty, "property");
      bindSelect(elPest, "pest");
      bindSelect(elPlan, "plan");
      bindSelect(elUrgency, "urgency");
      bindSelect(elAccess, "access");

      elAddonChecks.forEach((cb) => {
        cb.addEventListener("change", () => {
          const k = cb.getAttribute("data-addon");
          if (!k) return;
          if (cb.checked) state.addons.add(k);
          else state.addons.delete(k);
          render();
        });
      });

      btnWA.addEventListener("click", () => {
        const url = btnWA.getAttribute("data-wa");
        window.open(url, "_blank", "noopener,noreferrer");
      });

      btnCopy.addEventListener("click", async () => {
        const msg = btnCopy.getAttribute("data-msg") || "";
        try {
          await navigator.clipboard.writeText(msg);
          setToast("Copied message to clipboard.", "ok");
        } catch (e) {
          setToast("Clipboard blocked — copy from preview below.", "warn");
        }
      });

      // Init from defaults
      elProperty.value = state.property;
      elPest.value = state.pest;
      elPlan.value = state.plan;
      elUrgency.value = state.urgency;
      elAccess.value = state.access;

      render();
    })();
  </script>
</main>

