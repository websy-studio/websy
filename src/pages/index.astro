              <img src="https://images.unsplash.com/photo-1557434440-1db8a5d855f1?q=80&w=1200&auto=format&fit=crop" alt="" loading="lazy">
              <div class="pc-card-body">
                <div class="pc-card-title">Ants</div>
                <div class="pc-card-meta">Trail + nest control</div>
              </div>
            </button>

            <button class="pc-card" type="button" data-value="termites" data-label="Termites">
              <img src="https://images.unsplash.com/photo-1582555172866-f73bb12a2ab3?q=80&w=1200&auto=format&fit=crop" alt="" loading="lazy">
              <div class="pc-card-body">
                <div class="pc-card-title">Termites</div>
                <div class="pc-card-meta">Assessment recommended</div>
              </div>
            </button>

            <button class="pc-card" type="button" data-value="bed_bugs" data-label="Bed Bugs">
              <img src="https://images.unsplash.com/photo-1583946099379-f9c9cb8bc030?q=80&w=1200&auto=format&fit=crop" alt="" loading="lazy">
              <div class="pc-card-body">
                <div class="pc-card-title">Bed Bugs</div>
                <div class="pc-card-meta">Multi-step treatment</div>
              </div>
            </button>

            <button class="pc-card" type="button" data-value="mosquitoes" data-label="Mosquitoes">
              <img src="https://images.unsplash.com/photo-1615485737562-0e2d0e6c5b31?q=80&w=1200&auto=format&fit=crop" alt="" loading="lazy">
              <div class="pc-card-body">
                <div class="pc-card-title">Mosquitoes</div>
                <div class="pc-card-meta">Outdoor fogging</div>
              </div>
            </button>

            <button class="pc-card" type="button" data-value="rodents" data-label="Rodents">
              <img src="https://images.unsplash.com/photo-1520808663317-647b476a81b9?q=80&w=1200&auto=format&fit=crop" alt="" loading="lazy">
              <div class="pc-card-body">
                <div class="pc-card-title">Rodents</div>
                <div class="pc-card-meta">Traps + sealing advice</div>
              </div>
            </button>

            <button class="pc-card" type="button" data-value="general" data-label="General Pest">
              <img src="https://images.unsplash.com/photo-1527515637462-cff94eecc1ac?q=80&w=1200&auto=format&fit=crop" alt="" loading="lazy">
              <div class="pc-card-body">
                <div class="pc-card-title">General Pest</div>
                <div class="pc-card-meta">Broad coverage</div>
              </div>
            </button>
          </div>
        </div>

        <div class="pc-block pc-2col">
          <div>
            <div class="pc-label">Plan</div>
            <div class="pc-choices" data-group="plan">
              <button class="pc-chip is-on" type="button" data-value="one_time">One-time</button>
              <button class="pc-chip" type="button" data-value="quarterly">Quarterly</button>
              <button class="pc-chip" type="button" data-value="monthly">Monthly</button>
            </div>
          </div>

          <div>
            <div class="pc-label">Urgency</div>
            <div class="pc-choices" data-group="urgency">
              <button class="pc-chip is-on" type="button" data-value="standard">Standard</button>
              <button class="pc-chip" type="button" data-value="urgent">Urgent (same/next day)</button>
            </div>
          </div>
        </div>

        <div class="pc-block">
          <div class="pc-label">Access complexity</div>
          <div class="pc-choices" data-group="access">
            <button class="pc-chip is-on" type="button" data-value="normal">Normal</button>
            <button class="pc-chip" type="button" data-value="hard">Hard (tight areas / high clutter)</button>
          </div>
        </div>

        <div class="pc-block">
          <div class="pc-label">Add-ons</div>
          <div class="pc-addons">
            <label class="pc-check">
              <input type="checkbox" data-addon="inspection_report">
              <span>Inspection report (+SGD 40)</span>
            </label>
            <label class="pc-check">
              <input type="checkbox" data-addon="aftercare">
              <span>30-day aftercare support (+SGD 30)</span>
            </label>
            <label class="pc-check">
              <input type="checkbox" data-addon="gel_bait_upgrade">
              <span>Gel bait upgrade (+SGD 35)</span>
            </label>
            <label class="pc-check">
              <input type="checkbox" data-addon="rodent_traps">
              <span>Extra traps (rodents) (+SGD 45)</span>
            </label>
            <label class="pc-check">
              <input type="checkbox" data-addon="follow_up_visit">
              <span>Follow-up visit (+SGD 90)</span>
            </label>
          </div>
        </div>
      </div>

      <!-- RIGHT: Summary -->
      <aside class="pc-panel pc-summary" aria-label="Quote Summary">
        <div class="pc-sum-top">
          <div class="pc-sum-title">Your estimate</div>
          <div class="pc-sum-note">Final price may vary after onsite assessment.</div>
        </div>

        <div class="pc-sum-box">
          <div class="pc-row">
            <div class="pc-k">Property</div>
            <div class="pc-v" id="pcOutProperty">HDB</div>
          </div>
          <div class="pc-row">
            <div class="pc-k">Pest</div>
            <div class="pc-v" id="pcOutPest">Cockroaches</div>
          </div>
          <div class="pc-row">
            <div class="pc-k">Plan</div>
            <div class="pc-v" id="pcOutPlan">One-time</div>
          </div>
          <div class="pc-row">
            <div class="pc-k">Urgency</div>
            <div class="pc-v" id="pcOutUrgency">Standard</div>
          </div>
          <div class="pc-row">
            <div class="pc-k">Access</div>
            <div class="pc-v" id="pcOutAccess">Normal</div>
          </div>

          <div class="pc-divider"></div>

          <div class="pc-row pc-row-top">
            <div class="pc-k">Selected add-ons</div>
            <div class="pc-v pc-small" id="pcOutAddons">None</div>
          </div>

          <div class="pc-divider"></div>

          <div class="pc-total">
            <div>Total</div>
            <div class="pc-money" id="pcOutTotal">SGD 0</div>
          </div>
        </div>

        <div class="pc-actions">
          <button class="pc-btn" id="pcWhatsAppBtn" type="button">
            Send on WhatsApp
          </button>
          <button class="pc-btn pc-ghost" id="pcCopyBtn" type="button">
            Copy message
          </button>
        </div>

        <div class="pc-tip" id="pcTip" aria-live="polite"></div>
      </aside>
    </div>
  </section>

  <!-- Astro inline script -->
  <script is:inline>
    (function () {
      // ===== Config =====
      const WHATSAPP_NUMBER = "6591837777"; // change this
      const CURRENCY = "SGD";

      // Base prices
      const BASE_BY_PEST = {
        ants: 120,
        cockroaches: 150,
        termites: 380,
        bed_bugs: 420,
        mosquitoes: 180,
        rodents: 220,
        general: 160,
      };

      const MULT_PROPERTY = {
        hdb: 1.0,
        condo: 1.1,
        landed: 1.35,
        commercial: 1.45,
      };

      const MULT_URGENCY = { standard: 1.0, urgent: 1.2 };
      const MULT_ACCESS = { normal: 1.0, hard: 1.15 };

      // Plan multipliers (representing bundled pricing)
      const PLAN_MULT = {
        one_time: 1.0,
        quarterly: 2.6,
        monthly: 4.6,
      };

      const ADDONS = {
        inspection_report: { label: "Inspection report", price: 40 },
        aftercare: { label: "30-day aftercare support", price: 30 },
        gel_bait_upgrade: { label: "Gel bait upgrade", price: 35 },
        rodent_traps: { label: "Extra traps", price: 45 },
        follow_up_visit: { label: "Follow-up visit", price: 90 },
      };

      // ===== State =====
      const state = {
        property: "hdb",
        pest: "cockroaches",
        pestLabel: "Cockroaches",
        plan: "one_time",
        urgency: "standard",
        access: "normal",
        addons: new Set(),
      };

      // ===== Helpers =====
      function money(n) {
        // simple formatting; change if you want decimals
        return `${CURRENCY} ${Math.round(n)}`;
      }

      function labelProperty(v){
        return v === "hdb" ? "HDB" :
               v === "condo" ? "Condo" :
               v === "landed" ? "Landed" : "Commercial";
      }

      function labelPlan(v){
        return v === "one_time" ? "One-time" :
               v === "quarterly" ? "Quarterly" : "Monthly";
      }

      function labelUrgency(v){
        return v === "standard" ? "Standard" : "Urgent (same/next day)";
      }

      function labelAccess(v){
        return v === "normal" ? "Normal" : "Hard (tight areas / high clutter)";
      }

      function computeTotal() {
        const base = BASE_BY_PEST[state.pest] || 0;
        const mult =
          (MULT_PROPERTY[state.property] || 1) *
          (PLAN_MULT[state.plan] || 1) *
          (MULT_URGENCY[state.urgency] || 1) *
          (MULT_ACCESS[state.access] || 1);

        let subtotal = base * mult;

        let addonsTotal = 0;
        state.addons.forEach((k) => {
          addonsTotal += (ADDONS[k]?.price || 0);
        });

        const total = subtotal + addonsTotal;
        return { total, base, subtotal, addonsTotal };
      }

      function buildMessage(total) {
        const addonLabels = Array.from(state.addons).map((k) => ADDONS[k].label);

        const lines = [
          "Hi! I'd like a pest control quote:",
          "",
          `• Property: ${labelProperty(state.property)}`,
          `• Pest: ${state.pestLabel}`,
          `• Plan: ${labelPlan(state.plan)}`,
          `• Urgency: ${labelUrgency(state.urgency)}`,
          `• Access: ${labelAccess(state.access)}`,
          `• Add-ons: ${addonLabels.length ? addonLabels.join(", ") : "None"}`,
          "",
          `Estimated Total: ${money(total)}`,
          "",
          "Please advise earliest availability. Thank you!",
        ];

        return lines.join("\n");
      }

      function setActive(groupEl, value) {
        groupEl.querySelectorAll("button").forEach((btn) => {
          btn.classList.toggle("is-on", btn.getAttribute("data-value") === value);
        });
      }

      function setActiveCards(groupEl, value) {
        groupEl.querySelectorAll("button").forEach((btn) => {
          btn.classList.toggle("is-on", btn.getAttribute("data-value") === value);
        });
      }

      function render() {
        const { total } = computeTotal();

        // Outputs
        document.getElementById("pcOutProperty").textContent = labelProperty(state.property);
        document.getElementById("pcOutPest").textContent = state.pestLabel;
        document.getElementById("pcOutPlan").textContent = labelPlan(state.plan);
        document.getElementById("pcOutUrgency").textContent = labelUrgency(state.urgency);
        document.getElementById("pcOutAccess").textContent = labelAccess(state.access);

        const addonLabels = Array.from(state.addons).map((k) => ADDONS[k].label);
        document.getElementById("pcOutAddons").textContent = addonLabels.length ? addonLabels.join(", ") : "None";

        document.getElementById("pcOutTotal").textContent = money(total);

        // Store message for actions
        const msg = buildMessage(total);
        document.getElementById("pcWhatsAppBtn").setAttribute(
          "data-wa",
          `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(msg)}`
        );
        document.getElementById("pcCopyBtn").setAttribute("data-msg", msg);
      }

      // ===== Bind groups =====
      document.querySelectorAll('[data-group="property"]').forEach((group) => {
        group.addEventListener("click", (e) => {
          const btn = e.target.closest("button");
          if (!btn) return;
          state.property = btn.getAttribute("data-value");
          setActive(group, state.property);
          render();
        });
      });

      document.querySelectorAll('[data-group="plan"]').forEach((group) => {
        group.addEventListener("click", (e) => {
          const btn = e.target.closest("button");
          if (!btn) return;
          state.plan = btn.getAttribute("data-value");
          setActive(group, state.plan);
          render();
        });
      });

      document.querySelectorAll('[data-group="urgency"]').forEach((group) => {
        group.addEventListener("click", (e) => {
          const btn = e.target.closest("button");
          if (!btn) return;
          state.urgency = btn.getAttribute("data-value");
          setActive(group, state.urgency);
          render();
        });
      });

      document.querySelectorAll('[data-group="access"]').forEach((group) => {
        group.addEventListener("click", (e) => {
          const btn = e.target.closest("button");
          if (!btn) return;
          state.access = btn.getAttribute("data-value");
          setActive(group, state.access);
          render();
        });
      });

      // Pest cards
      document.querySelectorAll('[data-group="pest"]').forEach((group) => {
        group.addEventListener("click", (e) => {
          const btn = e.target.closest("button");
          if (!btn) return;
          state.pest = btn.getAttribute("data-value");
          state.pestLabel = btn.getAttribute("data-label") || "Pest";
          setActiveCards(group, state.pest);
          render();
        });
      });

      // Add-ons
      document.querySelectorAll("input[type=checkbox][data-addon]").forEach((cb) => {
        cb.addEventListener("change", () => {
          const key = cb.getAttribute("data-addon");
          if (!key) return;
          if (cb.checked) state.addons.add(key);
          else state.addons.delete(key);
          render();
        });
      });

      // Actions
      const tip = document.getElementById("pcTip");

      document.getElementById("pcWhatsAppBtn").addEventListener("click", () => {
        const url = document.getElementById("pcWhatsAppBtn").getAttribute("data-wa");
        window.open(url, "_blank", "noopener,noreferrer");
      });

      document.getElementById("pcCopyBtn").addEventListener("click", async () => {
        const msg = document.getElementById("pcCopyBtn").getAttribute("data-msg") || "";
        try {
          await navigator.clipboard.writeText(msg);
          tip.textContent = "Copied message to clipboard.";
          setTimeout(() => (tip.textContent = ""), 1800);
        } catch (err) {
          // fallback
          tip.textContent = "Clipboard blocked. Select & copy manually from your browser.";
          setTimeout(() => (tip.textContent = ""), 2200);
        }
      });

      // Initial render
      render();
    })();
  </script>
</main>

<style>
