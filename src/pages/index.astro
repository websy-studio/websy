---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>

  <body>
    <Header />

    <main>
      <section class="calc-wrapper">
        <header class="calc-header">
          <h1 class="calc-title">Instant Quote (Image Selector)</h1>
          <p class="calc-subtitle">
            Tap any service card to add/remove it. Total updates instantly.
          </p>
        </header>

        <div class="service-grid" id="serviceGrid">
          <!-- Card 1 -->
          <button
            class="service-card"
            type="button"
            data-id="wash"
            data-label="Exterior Wash"
            data-price="80"
          >
            <img
              src="https://images.unsplash.com/photo-1607860108855-64acf2078ed9?q=80&w=1200&auto=format&fit=crop"
              alt="Exterior wash"
              loading="lazy"
            />
            <div class="service-content">
              <div class="service-name">Exterior Wash</div>
              <div class="service-price">+ SGD 80</div>
            </div>
          </button>

          <!-- Card 2 -->
          <button
            class="service-card"
            type="button"
            data-id="interior"
            data-label="Interior Detailing"
            data-price="120"
          >
            <img
              src="https://images.unsplash.com/photo-1625047509168-a7026f36de04?q=80&w=1200&auto=format&fit=crop"
              alt="Interior detailing"
              loading="lazy"
            />
            <div class="service-content">
              <div class="service-name">Interior Detailing</div>
              <div class="service-price">+ SGD 120</div>
            </div>
          </button>

          <!-- Card 3 -->
          <button
            class="service-card"
            type="button"
            data-id="engine"
            data-label="Engine Bay Clean"
            data-price="60"
          >
            <img
              src="https://images.unsplash.com/photo-1517520287167-4bbf64a00d66?q=80&w=1200&auto=format&fit=crop"
              alt="Engine bay clean"
              loading="lazy"
            />
            <div class="service-content">
              <div class="service-name">Engine Bay Clean</div>
              <div class="service-price">+ SGD 60</div>
            </div>
          </button>
        </div>

        <div class="summary">
          <div class="summary-left">
            <div class="summary-title">Total</div>
            <div class="summary-note" id="summaryNote">No services selected yet.</div>
          </div>

          <div class="summary-right">
            <div class="total" id="totalPrice">SGD 0</div>
          </div>
        </div>
      </section>

      <!-- Astro inline script -->
      <script is:inline>
        (function () {
          const cards = document.querySelectorAll(".service-card");
          const totalEl = document.getElementById("totalPrice");
          const noteEl = document.getElementById("summaryNote");

          const selected = new Map();

          function formatSGD(n) {
            // Simple formatting for demo; upgrade later if you want Intl.NumberFormat
            return `SGD ${n}`;
          }

          function updateUI() {
            let total = 0;
            const labels = [];

            selected.forEach((price, label) => {
              total += price;
              labels.push(label);
            });

            totalEl.textContent = formatSGD(total);

            if (labels.length === 0) {
              noteEl.textContent = "No services selected yet.";
            } else {
              noteEl.textContent = `Selected: ${labels.join(", ")}`;
            }
          }

          cards.forEach((card) => {
            card.addEventListener("click", () => {
              const label = card.getAttribute("data-label") || "Service";
              const price = Number(card.getAttribute("data-price") || 0);

              const isOn = card.classList.toggle("selected");

              if (isOn) selected.set(label, price);
              else selected.delete(label);

              updateUI();
            });
          });

          updateUI();
        })();
      </script>
    </main>

    <Footer />
  </body>
</html>

<style>
  .calc-wrapper {
    max-width: 980px;
    margin: 40px auto;
    padding: 0 16px;
    font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
  }

  .calc-header {
    margin-bottom: 18px;
  }

  .calc-title {
    font-size: 28px;
    font-weight: 700;
    margin: 0 0 8px;
    letter-spacing: -0.02em;
  }

  .calc-subtitle {
    margin: 0;
    opacity: 0.75;
    line-height: 1.5;
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
  }

  .service-card {
    padding: 0;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 16px;
    overflow: hidden;
    cursor: pointer;
    background: #fff;
    text-align: left;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .service-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08);
  }

  .service-card.selected {
    border-color: rgba(0, 0, 0, 0.55);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.12);
  }

  .service-card img {
    width: 100%;
    height: 150px;
    object-fit: cover;
    display: block;
  }

  .service-content {
    padding: 12px 12px 14px;
  }

  .service-name {
    font-weight: 700;
    margin-bottom: 6px;
    font-size: 15px;
    line-height: 1.2;
  }

  .service-price {
    font-size: 13px;
    opacity: 0.75;
  }

  .summary {
    margin-top: 18px;
    padding: 14px 16px;
    border-radius: 16px;
    background: rgba(0, 0, 0, 0.04);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .summary-title {
    font-size: 13px;
    opacity: 0.75;
    margin-bottom: 4px;
  }

  .summary-note {
    font-size: 13px;
    opacity: 0.75;
  }

  .total {
    font-size: 18px;
    font-weight: 800;
    white-space: nowrap;
  }
</style>
